                    "propagation",
                    "sink",
                    "composition"
                  ],
                  "description": "Profile delta P3: 'composition' marks a trace entry that composes components (including a non-code, documentation-sanctioned decision point) rather than a code entrypoint/propagation/sink step."
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
